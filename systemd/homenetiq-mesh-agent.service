[Unit]
Description=HomeNetIQ meshlink VPN Health Agent
After=network-online.target
Wants=network-online.target

[Service]
# Template — scripts/install.sh fills User= and paths.
# meshlink-agent must be on PATH; coord_pubkey in config/meshlink_agent.yaml
# must match your coordinator.
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/homenetiq
ExecStart=/home/YOUR_USER/homenetiq/.venv/bin/python collectors/meshlink_agent.py --config config/meshlink_agent.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
