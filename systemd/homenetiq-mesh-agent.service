[Unit]
Description=HomeNetIQ meshlink VPN Health Agent
After=network-online.target
Wants=network-online.target

[Service]
# ŞABLONDUR — `scripts/install.sh` bu alanları otomatik doldurur.
# Elle düzenlerseniz şunları kendi cihazınıza göre değiştirin:
#   - User=            : Linux kullanıcı adı
#   - WorkingDirectory : Repo kökü
#   - ExecStart        : .venv python yolu ve config yolu
#
# Gereksinimler:
#   - meshlink binary'si PATH'te olmalı (bkz. scripts/install.sh)
#   - config/meshlink_agent.yaml içindeki coord_pubkey doğru olmalı
User=firat
WorkingDirectory=/home/firat/homenetiq
ExecStart=/home/firat/homenetiq/.venv/bin/python collectors/meshlink_agent.py --config config/meshlink_agent.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
