[Unit]
Description=HomeNetIQ Backend API
After=network-online.target
Wants=network-online.target

[Service]
# Bu dosya bir şablondur. Kurulumdan önce aşağıdaki alanları
# kendi cihazınıza göre düzenleyin:
#   - User=            : Linux kullanıcı adı (ör. "pi")
#   - WorkingDirectory : Repo kökü (ör. /home/<user>/homenetiq)
#   - EnvironmentFile  : .env dosyasının tam yolu
#   - ExecStart .venv  : Sanal ortam python yolu
# Örnek için docs/SETUP_RASPBERRY_PI.md dosyasına bakın.
User=pi
WorkingDirectory=/home/pi/homenetiq
EnvironmentFile=/home/pi/homenetiq/backend/.env
ExecStart=/home/pi/homenetiq/.venv/bin/uvicorn backend.app.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
