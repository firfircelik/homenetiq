[Unit]
Description=HomeNetIQ Backend API
After=network-online.target
Wants=network-online.target

[Service]
# Template: scripts/install.sh fills User= and paths. If you copy by hand:
#   User=            Linux account that owns the checkout
#   WorkingDirectory repo root
#   EnvironmentFile  path to backend/.env
#   ExecStart        venv uvicorn
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/homenetiq
EnvironmentFile=/home/YOUR_USER/homenetiq/backend/.env
ExecStart=/home/YOUR_USER/homenetiq/.venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
