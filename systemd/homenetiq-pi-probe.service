[Unit]
Description=HomeNetIQ Network Probe
After=homenetiq-backend.service
Wants=homenetiq-backend.service

[Service]
# Template. Edit User= and paths, or let scripts/install.sh fill them.
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/homenetiq
ExecStart=/home/YOUR_USER/homenetiq/.venv/bin/python probes/pi_network_probe.py --config config/pi_probe.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
