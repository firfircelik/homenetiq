[Unit]
Description=HomeNetIQ Linux Wi-Fi Agent
After=network-online.target
Wants=network-online.target

[Service]
# Template. Edit User= and paths, or let scripts/install.sh fill them.
#
# `iw` may need CAP_NET_ADMIN. Uncomment if the service cannot read the link:
#   CapabilityBoundingSet=CAP_NET_ADMIN
#   AmbientCapabilities=CAP_NET_ADMIN
#   NoNewPrivileges=true
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/homenetiq
ExecStart=/home/YOUR_USER/homenetiq/.venv/bin/python collectors/kali_wifi_agent.py --config config/kali_agent.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
