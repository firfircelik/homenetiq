device:
  id: "macos-wifi-1"
  name: "macOS Wi-Fi probe"
  type: "wifi_probe"
  os: "macos"
  agent_version: "1.0.0"

backend:
  url: "http://YOUR_BACKEND_HOST:8080/api/v1/metrics"
  token: "change-me-local-token"

collector:
  interval_seconds: 30
  retry_delay_seconds: 10
  timeout_seconds: 10

privacy:
  mode: "redact"
  salt: ""

targets:
  gateway_ip: ""      # your router LAN IP
  ap_ip: ""           # optional AP management IP
  internet_ip: "1.1.1.1"
