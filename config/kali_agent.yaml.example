device:
  id: "kali-macbook-air"
  name: "Kali MacBook Air 2015"
  type: "wifi_probe"
  os: "kali-linux"
  agent_version: "1.0.0"

backend:
  url: "http://192.168.1.50:8080/api/v1/metrics"
  token: "change-me-local-token"

collector:
  interface: "auto"
  interval_seconds: 30
  retry_delay_seconds: 10
  timeout_seconds: 10

privacy:
  mode: "redact"      # "redact" | "hash"
  salt: ""            # hash modunda kullanılır; sabit salt KULLANILMAZ

targets:
  gateway_ip: "192.168.1.1"
  ap_ip: "192.168.1.103"
  internet_ip: "1.1.1.1"
