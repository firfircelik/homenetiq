device:
  id: "linux-wifi-1"
  name: "Linux Wi-Fi probe"
  type: "wifi_probe"
  os: "linux"
  agent_version: "1.0.0"

backend:
  url: "http://YOUR_BACKEND_HOST:8080/api/v1/metrics"
  token: "change-me-local-token"

collector:
  interface: "auto"
  interval_seconds: 30
  retry_delay_seconds: 10
  timeout_seconds: 10

privacy:
  mode: "redact"      # "redact" | "hash"
  salt: ""            # used in hash mode; do not use a fixed public salt

targets:
  gateway_ip: ""      # your router LAN IP
  ap_ip: ""           # optional AP management IP
  internet_ip: "1.1.1.1"
