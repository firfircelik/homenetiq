device:
  id: "mesh-agent-1"
  name: "meshlink tunnel health"
  type: "network_probe"
  os: "linux"
  agent_version: "1.0.0"

backend:
  url: "http://YOUR_BACKEND_HOST:8080/api/v1/metrics"
  token: "change-me-local-token"

collector:
  interval_seconds: 30
  retry_delay_seconds: 10
  # meshlink status waits up to ~5 s for the registry reply; give it headroom.
  timeout_seconds: 20

privacy:
  mode: "redact"
  salt: ""

# meshlink status snapshot. This agent only READS it; it never configures the mesh.
meshlink:
  bin: "/usr/local/bin/meshlink-agent"  # or the path install.sh uses
  name: "b"
  keyfile: "/etc/meshlink/key.b"
  data: "0.0.0.0:19502"
  coordinator: "YOUR_COORDINATOR_HOST:19200"
  coord_pubkey: "<coordinator-control-public-key-hex>"
  stun: "YOUR_COORDINATOR_HOST:19201"
  relay: "YOUR_COORDINATOR_HOST:19205"
  # Optional: ping this peer once before snapshotting so path/RTT are real.
  probe_peer: "a"
  # Required when the meshlink coordinator was started with -preauth.
  preauth: "<YOUR_PREAUTH_TOKEN>"
