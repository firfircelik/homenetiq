device:
  id: "network-probe-1"
  name: "Network probe"
  type: "network_probe"
  os: "linux"
  agent_version: "1.0.0"

backend:
  url: "http://127.0.0.1:8080/api/v1/metrics"
  token: "change-me-local-token"

collector:
  interval_seconds: 30
  retry_delay_seconds: 10
  timeout_seconds: 10

privacy:
  mode: "redact"
  salt: ""

targets:
  gateway_ip: ""      # your router LAN IP
  ap_ip: ""           # optional AP management IP
  internet_ip: "1.1.1.1"
  dns_domains:
    - "google.com"
    - "github.com"
    - "cloudflare.com"
