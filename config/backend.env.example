# HomeNetIQ backend settings — copy to backend/.env and edit.
# Generate a token: openssl rand -hex 32
# Never run production with change-me-local-token (start will refuse unless
# HOMENETIQ_ALLOW_INSECURE=1).
HOMENETIQ_DB_PATH=/home/YOUR_USER/homenetiq/data/homenetiq.sqlite3
HOMENETIQ_API_TOKEN=change-me-local-token
HOMENETIQ_REQUIRE_AUTH=true
HOMENETIQ_REQUIRE_GET_AUTH=true
HOMENETIQ_STALE_AFTER_SECONDS=120
HOMENETIQ_OFFLINE_AFTER_SECONDS=600
# Optional: enrollment token accepted only on GET /api/v1/mesh/pubkey
# HOMENETIQ_ENROLL_TOKEN=
# Optional: pinned meshlink coordinator pubkey (identity, not membership)
# HOMENETIQ_MESH_PUBKEY=
